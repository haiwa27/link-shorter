# Vorlage. Kopieren nach .env und mit echten Werten füllen.
# .env ist in .gitignore und wird niemals eingecheckt.

# --- Anwendung ---------------------------------------------------------------
HEALTHGATE_ADRESSE=:8080
HEALTHGATE_UMGEBUNG=lokal
# Slot wird beim Deployment gesetzt: blue oder green
HEALTHGATE_SLOT=lokal
# Version wird von der Pipeline auf den Git-SHA gesetzt
HEALTHGATE_VERSION=dev
# Anteil absichtlich fehlerhafter Antworten (0.0 bis 1.0), Story R-06
HEALTHGATE_CHAOS_RATE=0.0
HEALTHGATE_WEB_VERZEICHNIS=/srv/web

# --- Datenbank (Story P-01) --------------------------------------------------
POSTGRES_DB=healthgate
POSTGRES_USER=healthgate
POSTGRES_PASSWORD=bitte-aendern
HEALTHGATE_DB_URL=postgres://healthgate:bitte-ändern@db:5432/healthgate?sslmode=disable

# --- Hostnamen (Platzhalter, echte Werte lokal einsetzen) -------------------
HEALTHGATE_HOST_PROD=kurz.beispiel.de
HEALTHGATE_HOST_STAGING=staging.beispiel.de

# --- Registry ----------------------------------------------------------------
REGISTRY=registry.beispiel.de/healthgate

# --- Monitoring --------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
GRAFANA_ADMIN_PASSWORT=bitte-aendern

# --- Beobachtungsfenster für den Health Gate (Story R-04) ------------------
OBSERVE_DAUER=120
OBSERVE_INTERVALL=10
OBSERVE_SCHWELLE=0.05
