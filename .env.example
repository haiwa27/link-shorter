# Vorlage. Kopieren nach .env und mit echten Werten füllen.
# .env ist in .gitignore und wird niemals eingecheckt.

# --- Anwendung ---------------------------------------------------------------
HEALTHGATE_ADRESSE=:8080
HEALTHGATE_UMGEBUNG=lokal
# Slot wird beim Deployment gesetzt: blue oder green. In prod Pflicht.
HEALTHGATE_SLOT=lokal
# Version wird von der Pipeline auf den Git-SHA gesetzt. In prod Pflicht.
HEALTHGATE_VERSION=dev
# Anteil absichtlich fehlerhafter Antworten (0.0 bis 1.0), Story R-06
HEALTHGATE_CHAOS_RATE=0.0
HEALTHGATE_WEB_VERZEICHNIS=/srv/web

# --- Datenbank (Story P-01) --------------------------------------------------
POSTGRES_DB=healthgate
POSTGRES_USER=healthgate
POSTGRES_PASSWORD=bitte-aendern
HEALTHGATE_DB_URL=postgres://healthgate:bitte-aendern@db:5432/healthgate?sslmode=disable

# --- Produktionsslots -------------------------------------------------------
# Werden von der Pipeline gesetzt. Die Chaos-Werte bleiben im Normalbetrieb 0.0
# und werden nur für die Vorführung des Rollbacks gesetzt.
# HEALTHGATE_IMAGE nennt das auszuliefernde Artefakt und wird von der Pipeline
# je Deployment gesetzt; hier steht nur ein Rückfallwert für den Handbetrieb.
HEALTHGATE_IMAGE=healthgate:dev
VERSION_BLUE=dev
VERSION_GREEN=dev
CHAOS_BLUE=0.0
CHAOS_GREEN=0.0

# --- Registry ----------------------------------------------------------------
REGISTRY=registry.beispiel.de/healthgate

# --- Deployment-Skripte -----------------------------------------------------
# Vorgaben genügen im Normalfall. Nur setzen, wenn abweichende Pfade oder
# Containernamen nötig sind.
CADDY_CONTAINER=healthgate-prod-caddy-1
BASIS_URL=http://localhost
WAIT_PAUSE=2
# KONF_DATEI=deploy/caddy/active-slot.conf
# ZUSTAND_VERZEICHNIS=deploy/state

# --- Monitoring --------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
GRAFANA_ADMIN_PASSWORT=bitte-aendern

# --- Health-Gate (Story R-04) -----------------------------------------------
OBSERVE_DAUER=120
OBSERVE_INTERVALL=10
OBSERVE_SCHWELLE=0.05
# Mindestlast, unter der observe.sh das Fenster als aussagelos meldet
OBSERVE_MIN_ANFRAGEN=5
