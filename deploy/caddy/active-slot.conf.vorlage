# Vorlage fuer den aktiven Slot. Die eigentliche Datei active-slot.conf ist
# Laufzeitzustand und deshalb nicht versioniert: sie sagt, welcher Slot gerade
# Verkehr bekommt. Laege sie im Repository, setzte jeder Checkout im
# Deployment-Verzeichnis den aktiven Slot still auf den eingecheckten Wert
# zurueck -- ohne dass irgendetwas davon sichtbar fehlschlaegt.
#
# switch-slot.sh legt sie beim ersten Lauf aus dieser Vorlage an.

reverse_proxy app-blue:8080 {
	health_uri /healthz
	health_interval 5s
	health_timeout 2s
}
